# ==============================================================================
# OpenWeather Environment Configuration Example
# Copy this file to .env.local to customize your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Keys & Authentication (Server-side)
# ------------------------------------------------------------------------------
# OpenWeatherMap API key (v2.5/v3.0 compatible)
# Get a key at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# CARTO Basemaps API key (removes "API KEY REQUIRED" watermark from Dark/Voyager tiles)
# Get a free key instantly (no account required) at: https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=

# Speech uses free Microsoft Edge neural voices (no key needed)

# ------------------------------------------------------------------------------
# 2. Location & Regional Defaults (Client & Server)
# ------------------------------------------------------------------------------
# Optional override for default city (leave blank to automatically detect from user's location)
NEXT_PUBLIC_DEFAULT_CITY=

# Optional fallback GPS latitude & longitude (used only if user location cannot be detected)
NEXT_PUBLIC_DEFAULT_LAT=
NEXT_PUBLIC_DEFAULT_LON=

# Optional fallback country label
NEXT_PUBLIC_DEFAULT_COUNTRY=

# Comma-separated list of popular hub cities for quick switching and comparison
NEXT_PUBLIC_POPULAR_CITIES="London, Tokyo, New York, Paris, Zurich, Sydney, Singapore, Reykjavik, Dubai, Mumbai, Toronto, Berlin"

# ------------------------------------------------------------------------------
# 3. Weather & Meteorological Source Settings
# ------------------------------------------------------------------------------
# Default provider: "open-meteo" | "openweathermap" | "simulation" | "auto"
NEXT_PUBLIC_DEFAULT_WEATHER_SOURCE=open-meteo

# Default Numerical Weather Prediction (NWP) model:
# "best_match" | "ecmwf_ifs025" | "gfs_seamless" | "icon_seamless" | "gem_seamless" | "meteofrance_seamless" | "jma_seamless"
NEXT_PUBLIC_DEFAULT_FORECAST_STATION=best_match

# Measurement units
NEXT_PUBLIC_DEFAULT_TEMP_UNIT=C
NEXT_PUBLIC_DEFAULT_WIND_UNIT=km/h
NEXT_PUBLIC_DEFAULT_PRESSURE_UNIT=hPa
NEXT_PUBLIC_DEFAULT_PRECIP_UNIT=mm

# Default language (e.g. en, es, fr, de, it, ja, ko, zh, hi, ar)
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Date & Time display formats
NEXT_PUBLIC_DEFAULT_TIME_FORMAT=24h
NEXT_PUBLIC_DEFAULT_DATE_FORMAT=iso
NEXT_PUBLIC_DEFAULT_COORDINATE_FORMAT=decimal

# ------------------------------------------------------------------------------
# 4. Text-to-Speech Defaults
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_TTS_SPEED=1.0
NEXT_PUBLIC_DEFAULT_TTS_PITCH=0.0
NEXT_PUBLIC_DEFAULT_TTS_VOLUME=0.0

# ------------------------------------------------------------------------------
# 5. External API Base URLs (Optional overrides for proxies/gateways/mirrors)
# ------------------------------------------------------------------------------
OPENWEATHER_API_BASE_URL=https://api.openweathermap.org
OPENWEATHER_GEO_BASE_URL=https://api.openweathermap.org/geo/1.0
OPEN_METEO_API_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEO_BASE_URL=https://geocoding-api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1
BIGDATACLOUD_GEO_BASE_URL=https://api.bigdatacloud.net/data
NEXT_PUBLIC_RAINVIEWER_API_BASE_URL=https://api.rainviewer.com
NEXT_PUBLIC_RAINVIEWER_TILE_BASE_URL=https://tilecache.rainviewer.com
NEXT_PUBLIC_CARTOCDN_TILE_BASE_URL=https://{s}.basemaps.cartocdn.com
NEXT_PUBLIC_OPENSTREETMAP_TILE_BASE_URL=https://{s}.tile.openstreetmap.org
